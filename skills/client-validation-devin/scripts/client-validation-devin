#!/usr/bin/env python3
"""client-validation-devin entry point: works when invoked directly or through a symlink on PATH."""

import os
import sys

if sys.version_info < (3, 11):
    sys.stderr.write(f"client-validation-devin needs Python 3.11+ (found {sys.version.split()[0]}); try `uv run --python 3.12 {sys.argv[0]}`\n")
    sys.exit(4)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from client_validation_devin.cli import main  # noqa: E402

sys.exit(main())
